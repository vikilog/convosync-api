{
  "name": "convosync-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate --schema=src/prisma/schema.prisma && tsx watch --import ./src/instrumentation.ts src/index.ts",
    "build": "tsc",
    "build:prod": "NODE_OPTIONS='--max-old-space-size=4096' prisma generate --schema=src/prisma/schema.prisma && NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "start": "node --import ./dist/instrumentation.js dist/index.js",
    "db:push": "prisma db push --schema=src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name init --schema=src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "seed:admin": "tsx scripts/seed-super-admin.ts",
    "razorpay:sync-plans": "tsx src/scripts/sync-razorpay-plans.ts",
    "razorpay:list-plans": "tsx src/scripts/list-razorpay-plans.ts",
    "db:reset": "tsx src/reset-db.ts",
    "wallet:simulate-debit": "tsx scripts/simulate-wallet-debit.ts",
    "wallet:test-auto-recharge": "tsx scripts/test-auto-recharge.ts",
    "wallet:reset-auto-recharge": "tsx scripts/reset-auto-recharge.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-ses": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.0.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "googleapis": "^173.0.0",
    "ioredis": "^5.4.0",
    "livekit-server-sdk": "^2.17.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^8.0.10",
    "openai": "^6.42.0",
    "pino": "^9.14.0",
    "prisma": "^6.0.0",
    "razorpay": "^2.9.6",
    "resend": "^4.8.0",
    "socket.io": "^4.8.0",
    "svix": "^1.95.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "typescript": "^5.6.0"
  }
}
