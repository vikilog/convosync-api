generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// SaaS tier for workspace (tenant) billing and feature gating.
enum Plan {
  FREE
  STARTER
  GROWTH
  SUPER_ADMIN
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// Platform-owner workspace — bypasses plan limits and embedded channel signup.
  isSuperAdmin Boolean @default(false)
  planTier    Plan     @default(FREE)
  legalName   String?
  industry    String?
  website     String?
  email       String?
  phone       String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  address     String?
  city        String?
  state       String?
  country     String?  @default("IN")
  postalCode  String?
  timezone    String?  @default("Asia/Kolkata")
  taxId       String?
  logoUrl     String?
  accountType     String?
  companySize     String?
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus String         @default("trial")
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  customPlanSelection Json?
  useCases        String[] @default([])
  heardAbout      String?
  referralCode    String?
  /// Razorpay customer for subscriptions and wallet auto-recharge.
  razorpayCustomerId String?
  waNumberId    String?
  waToken       String?
  wabaId        String?
  waPhoneNumber String?
  fbPageId      String?
  fbPageToken   String?
  fbPageName    String?
  metaAdAccountId String?
  metaUserToken   String?
  /// When true, workspace may send email via shared or custom domains.
  emailIntegrationEnabled Boolean @default(false)
  /// Manually flipped by us after reviewing a request — no self-serve toggle.
  whatsappFlowsEnabled Boolean @default(false)
  /// Set when the workspace clicks "Request Access" on the WhatsApp Flow card.
  whatsappFlowsRequestedAt DateTime?
  /// Kill switch — skips journeys, AgentFlow, AI agent/copilot auto-replies.
  automationsPaused Boolean @default(false)
  /// Last-resort reply when inbound is unassigned and nothing else matched.
  defaultReplyEnabled Boolean @default(false)
  defaultReplyText    String? @db.Text
  /// Auto-assignment for new inbound conversations: off | basic | advanced
  inboxAssignmentMode String  @default("off")
  /// Timezone for rule business-hours conditions; falls back to `timezone`, then Asia/Kolkata
  inboxAssignmentTimezone String?
  /// IG + Messenger persistent menu config (synced to Meta Profile API).
  /// Shape: { enabled, items: [{ id, title, type: postback|web_url, payload?, url? }] }
  persistentMenu Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  whatsappPhoneAccounts WhatsAppPhoneAccount[]
  instagramAccounts     InstagramAccount[]
  messengerAccounts     MessengerAccount[]
  telegramAccounts      TelegramAccount[]
  socialComments        SocialComment[]
  leadFunnels           LeadFunnel[]
  leads                 Lead[]
  socialListeningSettings SocialListeningSettings?
  socialListeningActivities SocialListeningActivity[]
  socialListeningPostSettings SocialListeningPostSetting[]
  memberships   WorkspaceMembership[]
  users         User[]
  contacts      Contact[]
  conversations     Conversation[]
  campaigns         Campaign[]
  journeys          Journey[]
  instagramJourneys InstagramJourney[]
  agents            AiAgent[]
  agentFlowSessions AgentFlowSession[]
  mediaAssets       MediaAsset[]
  templates         Template[]
  whatsAppFlows     WhatsAppFlow[]
  aiKnowledgeConfigs AiKnowledgeConfig[]
  aiKnowledgeRecords AiKnowledge[]
  developerIncomingWebhook DeveloperIncomingWebhook?
  developerOutgoingWebhooks DeveloperOutgoingWebhook[]
  developerActions DeveloperAction[]
  developerSyncEvents DeveloperSyncEvent[]
  developerWebhookLogs DeveloperWebhookLog[]
  emailDomains EmailDomain[]
  emailAddresses EmailAddress[]
  emailLogs EmailLog[]
  emailProviderConfigs EmailProviderConfig[]
  emailTemplates EmailTemplate[]
  cannedResponses CannedResponse[]
  googleConnections GoogleConnection[]
  googleProductIntegrations GoogleProductIntegration[]
  googleSyncLogs GoogleSyncLog[]
  googleWebhookLogs GoogleWebhookLog[]
  googleBusinessAccounts GoogleBusinessAccount[]
  googleBusinessLocations GoogleBusinessLocation[]
  googleBusinessReviews GoogleBusinessReview[]
  googleBusinessMetrics GoogleBusinessMetric[]
  googleBusinessSyncLogs GoogleBusinessSyncLog[]
  trialExtensionLogs   TrialExtensionLog[]
  billingSubscriptions BillingSubscription[]
  billingInvoices      BillingInvoice[]
  billingAddOnPurchases BillingAddOnPurchase[]
  paymentIntents       PaymentIntent[]
  billingOffers        BillingOffer[]
  usageLimits          WorkspaceUsageLimits?
  agentChatConversations AgentChatConversation[]
  tokenUsageLogs         TokenUsageLog[]
  aiProviderConfig       WorkspaceAiProviderConfig?
  emailConfig            WorkspaceEmailConfig?
  whatsappPaymentRequests WhatsAppPaymentRequest[]
  wallet                  WorkspaceWallet?
  walletTransactions      WalletTransaction[]
  callSessions            CallSession[]
  contactInsights         ContactInsight[]
  notificationPreferences NotificationPreference[]
  workspaceNotifications  WorkspaceNotification[]
  teamChatMessages        TeamChatMessage[]
  inboxTeamGroups         InboxTeamGroup[]
  inboxAssignmentRules    InboxAssignmentRule[]
  workspaceTags           WorkspaceTag[]
  discountCouponRedemptions DiscountCouponRedemption[]
}

/// Per-event outbound notify prefs (email today; SMS/WA later via channels JSON).
model NotificationPreference {
  id          String   @id @default(cuid())
  workspaceId String
  /// e.g. "human_handoff", "wallet_low"
  eventType   String
  enabled     Boolean  @default(true)
  /// { email: { enabled, recipients, subjectTemplate, bodyTemplate }, whatsapp: { enabled, phoneNumbers, userIds, templateId, variableMap }, inApp }
  channels    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventType])
  @@index([workspaceId])
  @@map("notification_preferences")
}

/// In-app workspace event log (bell + dashboard recent activity).
model WorkspaceNotification {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Extensible string constant — see NOTIFICATION_TYPES
  type         String
  /// Extensible bucket: campaigns | system | imports | inbox | …
  category     String
  title        String
  message      String
  entityType   String?
  entityId     String?
  /// Who triggered the event (activity scoping for agents).
  actorUserId  String?
  actor        User?    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Explicit recipient when the event is targeted (activity scoping).
  targetUserId String?
  targetUser   User?    @relation("NotificationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  /// When true, surfaces in the notifications bell (+ socket push). Activity feed always includes the row.
  forBell      Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())

  reads NotificationRead[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, category, createdAt])
  @@index([workspaceId, actorUserId, createdAt])
  @@index([workspaceId, forBell, createdAt])
  @@map("workspace_notifications")
}

/// Per-user read state for workspace notifications.
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  notification   WorkspaceNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

/// 1:1 team DM within a workspace (v1 — no workspace-wide room).
model TeamChatMessage {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  senderUserId    String
  sender          User     @relation("TeamChatSent", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User     @relation("TeamChatReceived", fields: [recipientUserId], references: [id], onDelete: Cascade)
  /// Sorted `userA:userB` for cheap pairwise lookups.
  dmPairKey       String
  body            String   @db.Text
  createdAt       DateTime @default(now())

  @@index([workspaceId, dmPairKey, createdAt])
  @@index([workspaceId, recipientUserId, createdAt])
  @@map("team_chat_messages")
}

enum GoogleConnectionStatus {
  active
  revoked
  error
  expired
}

enum GoogleProductKey {
  calendar
  business_profile
  sheets
  drive
  gmail
  meet
}

enum GoogleProductStatus {
  disconnected
  connected
  error
}

/// Organization-level Google account (workspace = org tenancy).
model GoogleConnection {
  id              String                 @id @default(cuid())
  workspaceId     String
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  googleAccountId String
  encryptedTokens String
  expiresAt       DateTime?
  scopes          String[]
  status          GoogleConnectionStatus @default(active)
  displayName     String?
  pictureUrl      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  productIntegrations GoogleProductIntegration[]
  syncLogs            GoogleSyncLog[]
  webhookLogs         GoogleWebhookLog[]

  @@unique([workspaceId, googleAccountId])
  @@index([workspaceId])
}

model GoogleProductIntegration {
  id           String              @id @default(cuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection   GoogleConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product      GoogleProductKey
  status       GoogleProductStatus @default(disconnected)
  config       Json?
  lastSyncAt   DateTime?
  lastError    String?
  syncCount    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([connectionId, product])
  @@index([workspaceId])
  @@index([workspaceId, product])
}

model GoogleSyncLog {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  product      GoogleProductKey
  action       String
  status       String
  message      String?
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@index([workspaceId, product])
  @@index([connectionId])
}

model GoogleWebhookLog {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  product      GoogleProductKey
  eventType    String
  payload      Json?
  status       String
  error        String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([workspaceId, product])
}

enum GoogleBusinessSyncStatus {
  idle
  pending
  syncing
  success
  error
}

enum GoogleBusinessSyncType {
  accounts
  locations
  reviews
  metrics
  cache_rebuild
}

/// Cached Google Business Profile account (from mybusinessaccountmanagement).
model GoogleBusinessAccount {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId      String
  googleAccountName String
  displayName       String?
  accountType       String?
  rawData           Json?
  lastSyncedAt      DateTime?
  lastSuccessAt     DateTime?
  lastError         String?
  syncStatus        GoogleBusinessSyncStatus @default(idle)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  locations GoogleBusinessLocation[]

  @@unique([connectionId, googleAccountName])
  @@index([workspaceId])
  @@index([connectionId])
}

/// Cached GBP location (from mybusinessbusinessinformation).
model GoogleBusinessLocation {
  id                 String                   @id @default(cuid())
  workspaceId        String
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId       String
  accountId          String
  account            GoogleBusinessAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  googleLocationName String
  title              String?
  address            Json?
  regularHours       Json?
  metadata           Json?
  rawData            Json?
  lastSyncedAt       DateTime?
  lastLocationSyncAt DateTime?
  lastReviewSyncAt   DateTime?
  lastMetricSyncAt   DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  syncStatus         GoogleBusinessSyncStatus @default(idle)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  reviews GoogleBusinessReview[]
  metrics GoogleBusinessMetric[]

  @@unique([connectionId, googleLocationName])
  @@index([workspaceId])
  @@index([connectionId])
  @@index([accountId])
}

/// Cached GBP review (incremental sync ready).
model GoogleBusinessReview {
  id             String                 @id @default(cuid())
  workspaceId    String
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId   String
  locationId     String
  location       GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  googleReviewId String
  reviewerName   String?
  starRating     Int?
  comment        String?
  reviewReply    String?
  createTime     DateTime?
  updateTime     DateTime?
  rawData        Json?
  lastSyncedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([locationId, googleReviewId])
  @@index([workspaceId])
  @@index([locationId])
  @@index([updateTime])
}

/// Cached GBP metrics snapshot per location.
model GoogleBusinessMetric {
  id           String                 @id @default(cuid())
  workspaceId  String
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  locationId   String
  location     GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  metricType   String
  periodStart  DateTime?
  periodEnd    DateTime?
  value        Json?
  rawData      Json?
  lastSyncedAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([workspaceId])
  @@index([locationId])
  @@index([metricType])
}

/// GBP-specific sync audit log (quota, duration, request counts).
model GoogleBusinessSyncLog {
  id            String                 @id @default(cuid())
  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId  String
  syncType      GoogleBusinessSyncType
  durationMs    Int?
  requestCount  Int                    @default(0)
  responseCount Int                    @default(0)
  status        String
  error         String?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([workspaceId, connectionId])
  @@index([syncType])
  @@index([createdAt])
}

model WhatsAppPhoneAccount {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumberId  String
  metaUserId     String?
  wabaId         String
  phoneNumber    String?
  displayName    String?
  /// business_api | app_coexistence
  connectionMode String    @default("business_api")
  /// self_pay | platform | null (not chosen yet)
  paymentMode    String?
  /// True when Meta reports messaging billing funding on the WABA (primary_funding_id).
  /// Never set true from user ack — Tech Providers often cannot read this field (#10).
  hasOwnMetaPaymentMethod Boolean @default(false)
  /// confirmed | missing | unknown (unknown = BSP-gated probe / Graph #10 for Tech Providers)
  billingCheckStatus String?
  paymentConfigCheckedAt  DateTime?
  /// User said they added a Meta card when auto-check is unknown — UI only, not Meta truth.
  paymentSetupAcknowledgedAt DateTime?
  /// Meta Business portfolio ID from Embedded Signup / owner_business_info (for BM billing URL).
  metaBusinessId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, phoneNumberId])
  @@index([workspaceId])
  @@index([metaUserId])
}

model InstagramAccount {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramUserId  String
  metaUserId       String?
  pageId           String
  pageName         String?
  username         String?
  displayName      String?
  profilePicture   String?
  /// Encrypted Page access token (csenc:v1:) — same helper as WhatsApp.
  pageAccessToken  String
  /// connected | expired | revoked | error
  status           String    @default("connected")
  /// Page tokens from long-lived user tokens usually do not expire; set when Meta reports expiry.
  tokenExpiresAt   DateTime?
  tokenValidatedAt DateTime?
  connectedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  socialComments SocialComment[]

  @@unique([workspaceId, instagramUserId])
  @@index([workspaceId])
  @@index([metaUserId])
  @@index([status])
}

/// Instagram comment persisted for AI classification + Review Queue.
model SocialComment {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// InstagramAccount.id
  socialAccountId      String
  socialAccount        InstagramAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  /// IG media / post id
  postId               String
  /// IG comment id (Graph)
  commentId            String
  parentCommentId      String?
  commenterUsername    String?
  /// IG-scoped commenter id (webhook `from.id`) — used to link the eventual
  /// Lead to the SAME Contact row findOrCreateInstagramContact already
  /// created for this commenter, instead of a synthetic phone that can
  /// never match.
  commenterId          String?
  commenterProfilePic  String?
  commentText          String
  /// interested | question | complaint | spam | unclear | null while pending
  intent               String?
  /// 0–1 confidence; null while pending / failed
  confidence           Float?
  /// pending | classified | failed
  classificationStatus String    @default("pending")
  classificationError  String?
  /// new | approved | replied | escalated | ignored
  status               String    @default("new")
  suggestedReply       String?
  /// Audit: public comment reply sent on approve_dm / approve_reply
  publicReplyText      String?
  /// Audit: private DM text sent via Private Reply API
  dmReplyText          String?
  dmSentAt             DateTime?
  /// none | pending | sent | failed | skipped
  dmStatus             String    @default("none")
  dmError              String?
  postCaption          String?
  postThumbnailUrl     String?
  commentedAt          DateTime?
  leadId               String?   @unique
  lead                 Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([workspaceId, commentId])
  @@index([workspaceId, status])
  @@index([workspaceId, postId])
  @@index([socialAccountId])
  @@index([classificationStatus])
}

/// Sales funnel — Kanban board container. Never auto-created.
model LeadFunnel {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String    @default("")
  /// Free-text goal (e.g. target count / revenue / outcome).
  goal        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stages                    LeadFunnelStage[]
  leads                     Lead[]
  socialListeningAsTarget   SocialListeningSettings[]
  socialListeningPostTargets SocialListeningPostSetting[]

  @@index([workspaceId])
}

/// Kanban columns for a funnel. Default: single "New" board on funnel create.
model LeadFunnelStage {
  id        String    @id @default(cuid())
  funnelId  String
  funnel    LeadFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  name      String
  /// Display order left → right (0 = first).
  position  Int       @default(0)
  /// Final board — leads here can convert to Contact.
  isFinal   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]

  @@index([funnelId, position])
  // Partial unique index (funnelId) WHERE isFinal = true lives in a
  // hand-written migration — Prisma's DSL can't express a filtered index.
  // See 20260817100000_lead_funnel_single_final_stage.
}

model Lead {
  id                     String     @id @default(cuid())
  workspaceId            String
  workspace              Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnelId               String?
  funnel                 LeadFunnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  /// Kanban column (LeadFunnelStage.id). Null = orphan / legacy.
  stageId                String?
  funnelStage            LeadFunnelStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  /// Linked CRM contact after convert-from-final-board.
  contactId              String?
  contact                Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name                   String?
  phone                  String?
  email                  String?
  /// Denormalized stage name for activity / legacy display (synced from stageId).
  stage                  String    @default("New")
  /// instagram | manual | whatsapp
  source                 String    @default("instagram")
  requirement            String    @default("")
  notes                  String    @default("")
  originUsername         String?
  originCommentText      String?
  originPostThumbnailUrl String?
  originPostCaption      String?
  originCommentedAt      DateTime?
  /// [{ id, type, text, at }]
  activity               Json      @default("[]")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  socialComment SocialComment?

  @@index([workspaceId, stage])
  @@index([workspaceId, source])
  @@index([workspaceId, createdAt])
  @@index([funnelId, stage])
  @@index([stageId])
  @@index([contactId])
  // Partial unique index (workspaceId, contactId, funnelId) WHERE contactId
  // IS NOT NULL AND funnelId IS NOT NULL lives in a hand-written migration —
  // Prisma's DSL can't express a filtered index. See
  // 20260817093000_lead_contact_funnel_unique.
}

/// Per-workspace Social Listening automation (auto-reply / DM / lead rules).
model SocialListeningSettings {
  id                  String    @id @default(cuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Master toggle — OFF = everything stays in review (safe default).
  /// Requires leadFunnelId when true (no funnel = no automation).
  autoResponseEnabled Boolean   @default(false)
  /// Target funnel for auto-created leads; required to enable automation.
  leadFunnelId        String?
  leadFunnel          LeadFunnel? @relation(fields: [leadFunnelId], references: [id], onDelete: SetNull)
  /// auto | review | off
  interestedMode      String    @default("review")
  /// auto | review | off
  questionMode        String    @default("review")
  /// review | escalate_only — never auto
  complaintMode       String    @default("review")
  /// auto_ignore | review
  spamMode            String    @default("review")
  /// 0–100; auto mode requires confidence >= this
  confidenceThreshold Int       @default(80)
  /// friendly | professional | playful
  publicReplyTone     String    @default("friendly")
  /// Optional AiSkill.id for DM generation context
  dmAgentSkillId      String?
  fallbackMessage     String?
  /// interested_only | interested_and_questions | never
  leadCreationRule    String    @default("interested_only")
  maxAutoDmsPerDay    Int       @default(50)
  workingHoursOnly    Boolean   @default(false)
  /// HH:mm
  workingHoursStart   String?
  /// HH:mm
  workingHoursEnd     String?
  updatedAt           DateTime  @updatedAt
}

/// Lightweight audit feed for Social Listening automation / approvals.
model SocialListeningActivity {
  id               String   @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// auto_dm | auto_ignore | auto_escalate | manual_approve_dm | dm_failed | dm_sent | lead_created | classified
  eventType        String
  message          String
  relatedCommentId String?
  relatedLeadId    String?
  meta             Json?
  createdAt        DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, eventType, createdAt])
}

/// Per Instagram media (post/reel) agent + automation settings for a workspace.
/// Missing row = Agent OFF (safe). All rules are post-wise (not workspace defaults).
model SocialListeningPostSetting {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Instagram Graph media id (same as SocialComment.postId)
  postId              String
  /// Master agent toggle — OFF = comments stay in review.
  autoResponseEnabled Boolean   @default(false)
  /// Funnel for leads from this post; required when autoResponseEnabled.
  leadFunnelId        String?
  leadFunnel          LeadFunnel? @relation(fields: [leadFunnelId], references: [id], onDelete: SetNull)
  /// Published Instagram automation to start when this post gets a comment.
  commentAutomationJourneyId String?
  commentAutomationJourney   InstagramJourney? @relation(fields: [commentAutomationJourneyId], references: [id], onDelete: SetNull)
  interestedMode      String    @default("review")
  questionMode        String    @default("review")
  complaintMode       String    @default("review")
  spamMode            String    @default("review")
  confidenceThreshold Int       @default(80)
  publicReplyTone     String    @default("friendly")
  dmAgentSkillId      String?
  fallbackMessage     String?
  leadCreationRule    String    @default("interested_only")
  maxAutoDmsPerDay    Int       @default(50)
  workingHoursOnly    Boolean   @default(false)
  workingHoursStart   String?
  workingHoursEnd     String?
  /// Atomic reservation counter for maxAutoDmsPerDay — see migration
  /// 20260817110000_social_listening_auto_dm_counter. autoDmsCounterDate
  /// holds the workspace-tz start-of-day this count belongs to; a mismatch
  /// against the caller's freshly-computed "today" means the bucket has
  /// rolled over and the count is stale (treated as 0).
  autoDmsCounterDate  DateTime?
  autoDmsCounterCount Int       @default(0)
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, postId])
  @@index([workspaceId])
  @@index([leadFunnelId])
  @@index([commentAutomationJourneyId])
}

model MessengerAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metaUserId      String?
  pageId          String
  pageName        String?
  displayName     String?
  profilePicture  String?
  pageAccessToken String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, pageId])
  @@index([workspaceId])
  @@index([metaUserId])
}

model TelegramAccount {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  botId         String
  botUsername   String?
  botName       String?
  botToken      String
  /// Verifies incoming webhook calls via X-Telegram-Bot-Api-Secret-Token.
  /// Null until the bot completes webhook registration (e.g. legacy rows pre-dating this field).
  webhookSecret String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceId, botId])
  @@index([workspaceId])
  @@index([botId])
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("admin")
  /// Granular access for agents; admins implicitly have all permissions.
  permissions String[]  @default([])
  /// When inbox permission is restricted: channel types and specific account IDs.
  inboxScope  Json?
  /// Whether this member can receive inbound conversations from auto-assignment.
  autoAssignEligible Boolean   @default(true)
  /// Max open conversations this member can hold via auto-assignment; null = unlimited.
  assignmentLimit    Int?
  /// Last time auto-assignment picked this member — drives round-robin ordering.
  lastAutoAssignedAt DateTime?
  createdAt   DateTime  @default(now())

  groupMemberships InboxTeamGroupMember[]

  @@unique([userId, workspaceId])
  @@index([userId])
}

model InboxTeamGroup {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members InboxTeamGroupMember[]
  rules   InboxAssignmentRule[]

  @@index([workspaceId])
}

model InboxTeamGroupMember {
  id           String              @id @default(cuid())
  groupId      String
  group        InboxTeamGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membershipId String
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@unique([groupId, membershipId])
  @@index([membershipId])
}

model InboxAssignmentRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean   @default(true)
  /// Lower evaluates first.
  priority    Int       @default(0)
  /// { channels?: string[], contactTags?: string[] (any-of), businessHours?: { days: number[] (0=Sun..6=Sat), start: "HH:mm", end: "HH:mm", timezone?: string } }
  conditions  Json      @default("{}")
  /// group | user
  actionType    String
  actionGroupId String?
  actionGroup   InboxTeamGroup? @relation(fields: [actionGroupId], references: [id], onDelete: SetNull)
  /// User id when actionType = user
  actionUserId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, priority])
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("agent")
  avatar      String?
  phone       String?
  jobTitle    String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  onboardingStep          Int      @default(7)
  onboardingCompleted     Boolean  @default(true)
  onboardingSkippedSteps  Int[]    @default([])
  onboardingData          Json?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())

  memberships           WorkspaceMembership[]
  assignedConversations Conversation[]
  securityState         UserSecurityState?
  assignedCalls         CallSession[]          @relation("CallAssignedAgent")
  acceptedCalls         CallSession[]          @relation("CallAcceptedAgent")
  initiatedCalls        CallSession[]          @relation("CallInitiatedBy")
  callParticipations    CallParticipant[]
  notificationReads     NotificationRead[]
  teamChatSent          TeamChatMessage[] @relation("TeamChatSent")
  teamChatReceived      TeamChatMessage[] @relation("TeamChatReceived")
  actedNotifications    WorkspaceNotification[] @relation("NotificationActor")
  targetedNotifications WorkspaceNotification[] @relation("NotificationTarget")

  @@index([workspaceId])

}

/// Session invalidation state (logout-everywhere / password change). Separate from User.
model UserSecurityState {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion  Int      @default(0)
  updatedAt     DateTime @updatedAt
  updatedReason String?

  @@map("user_security_states")
}

model Contact {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String?
  avatar        String?
  source        String?
  tags          String[]
  customFields  Json?
  journeyStatus String?
  /// Shared across manually linked multi-channel contacts (same person).
  linkGroupId   String?
  /// Team/test numbers — never enqueue contact-insight compute
  excludeFromInsights Boolean @default(false)
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations     Conversation[]
  journeyExecutions JourneyExecution[]
  instagramJourneyExecutions InstagramJourneyExecution[]
  agentFlowSessions AgentFlowSession[]
  whatsappPaymentRequests WhatsAppPaymentRequest[]
  callSessions      CallSession[]
  callParticipations CallParticipant[]
  insights          ContactInsight[]
  leads             Lead[]

  @@unique([phone, workspaceId])
  @@index([workspaceId, excludeFromInsights])
  @@index([workspaceId, linkGroupId])
}

model Conversation {
  id            String    @id @default(cuid())
  status        String    @default("open")
  channel       String    @default("whatsapp")
  channelAccountId String?
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id])
  assignedTo    String?
  agent         User?     @relation(fields: [assignedTo], references: [id])
  /// Who handles this thread: user | ai | rule_based | journey (null = unassigned automation)
  assigneeType  String?
  /// User id, rule_based agent id, or journey id depending on assigneeType
  assigneeId    String?
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)
  labels        String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages          Message[]
  events            ConversationEvent[]
  agentFlowSession  AgentFlowSession?
  callSessions      CallSession[]

  @@index([workspaceId, contactId])
  @@index([workspaceId, channelAccountId])
}

/// Timeline events for AI ↔ human handover (inbox chat).
model ConversationEvent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// AI_ASSIGNED | AI_HANDLING_STARTED | HUMAN_TAKEOVER | HUMAN_RELEASED_TO_AI | CONVERSATION_RESOLVED | CONVERSATION_REOPENED
  type           String
  /// AI_AGENT | HUMAN | SYSTEM
  actorType      String
  actorId        String?
  actorName      String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// LiveKit 1:1 voice call between customer and agent (media via LiveKit; sockets = signaling only).
model CallSession {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// inbound = customer→agent | outbound = agent→customer
  direction       String
  /// initiated | ringing | accepted | connected | declined | missed | ended | failed
  status          String
  roomName        String   @unique
  livekitRoomSid  String?

  /// Who is speaking on the call: none | ai | human
  currentHandler       String    @default("none")
  takenOverAt          DateTime?
  takenOverByUserId    String?

  initiatedByUserId String?
  initiatedBy       User?   @relation("CallInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  assignedTo        String?
  assignedAgent     User?   @relation("CallAssignedAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  acceptedByUserId  String?
  acceptedBy        User?   @relation("CallAcceptedAgent", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  ringingAt       DateTime?
  ringingUntil    DateTime?
  acceptedAt      DateTime?
  connectedAt     DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  endReason       String?
  /// Audit: [{ at, from, to, reason? }]
  metadata        Json?

  /// Guest (customer) join — short-lived signed link; jti binds one active guest session
  guestTokenJti       String?
  guestTokenExpiresAt DateTime?
  /// Short public code → /c/{code} redirects to /call/{id}?t=…
  guestShortCode      String?  @unique
  guestJoinedAt       DateTime?
  guestLinkSentAt     DateTime?

  /// LiveKit room composite egress (audio) — uploaded after call ends
  /// idle | recording | processing | ready | failed | skipped
  recordingStatus            String?
  recordingEgressId          String?
  recordingStorageKey        String?
  recordingUrl               String?
  recordingStartedAt         DateTime?
  recordingEndedAt           DateTime?
  recordingDurationSeconds   Int?
  recordingCodec             String?
  recordingFileSize          Int?
  recordingError             String?

  /// Client QoS snapshot (packet loss, jitter, rtt, mos, device, browser, …)
  analyticsJson       Json?

  /// Faster-Whisper STT (post-call) — pending | processing | ready | failed | skipped
  transcriptStatus    String?
  transcriptText      String?  @db.Text
  /// [{ start, end, text }]
  transcriptJson      Json?
  transcriptLanguage  String?
  transcriptError     String?
  transcriptAt        DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants    CallParticipant[]

  @@index([workspaceId, status])
  @@index([conversationId])
  @@index([workspaceId, assignedTo, status])
  @@index([workspaceId, createdAt])
  @@index([guestTokenJti])
  @@map("call_sessions")
}

/// History of customer insights (one row per computation — keep trends).
model ContactInsight {
  id                     String   @id @default(cuid())
  workspaceId            String
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId              String
  contact                Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// false = internal/test-only history; scores left null
  isGenuineCustomerInteraction Boolean @default(true)

  /// 0–100 overall relationship health (null if not genuine)
  healthScore            Int?
  /// 0–100; higher = more likely to churn
  churnRiskScore         Int?
  /// 0–100; higher = more ready to buy
  purchaseIntentScore    Int?
  /// −100…100 (negative = negative sentiment)
  sentimentScore         Int?

  summary                String   @db.Text
  /// string[]
  painPoints             Json
  /// string[]
  interests              Json
  recommendedAction      String?  @db.Text

  /// Conversation ids that fed this run
  basedOnConversationIds Json
  /// CallSession ids that fed this run
  basedOnCallSessionIds  Json

  /// Prompt / pipeline version for A/B and regressions
  modelVersion           String
  computedAt             DateTime @default(now())

  @@index([workspaceId, contactId, computedAt])
  @@index([workspaceId, churnRiskScore])
  @@index([workspaceId, purchaseIntentScore])
  @@index([workspaceId, isGenuineCustomerInteraction])
  @@map("contact_insights")
}

model CallParticipant {
  id            String   @id @default(cuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  /// customer | agent | ai | sip
  role          String
  /// LiveKit participant identity
  identity      String
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  joinedAt      DateTime?
  leftAt        DateTime?
  createdAt     DateTime @default(now())

  @@unique([callSessionId, identity])
  @@index([callSessionId])
  @@map("call_participants")
}

model Message {
  id             String       @id @default(cuid())
  waMessageId    String?      @unique
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String
  senderName     String?
  content        String
  type           String       @default("text")
  /// sent | delivered | read | failed | resend_pending | resent | sending
  status         String       @default("sent")
  /// Incremented each time a failed message enters resend_pending
  retryCount     Int          @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])

}

model Template {
  id               String    @id @default(cuid())
  name             String
  category         String
  status           String    @default("draft")
  language         String    @default("en")
  bodyPattern      String
  header           String?
  headerFormat     String?
  headerMediaHandle String?
  headerMediaStorageKey String?
  headerMediaMimeType String?
  headerMediaFileName String?
  footer           String?
  variables        String[]
  buttons          String[]
  buttonType       String?
  buttonText       String?
  buttonUrl        String?
  buttonPhoneNumber String?
  /// WhatsAppFlow.id — set when buttonType is FLOW. Meta stores its own copy on the
  /// approved template (metaFlowId baked into the submitted components); this is only
  /// so ConvoSync can show which flow a template's button opens and regenerate a
  /// flow_token per send.
  buttonFlowId     String?
  rejectionReason  String?
  waTemplateId     String?
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Matches Meta's real uniqueness rule (name + language, not name alone) —
  /// see migration 20260818070000_template_name_language_unique. A
  /// (workspaceId, name) constraint alone made a legitimate multi-language
  /// rollout of the same template name impossible, and made syncTemplatesFromMeta's
  /// upsert key collide two different-language templates that share a name.
  @@unique([workspaceId, name, language])
  @@index([workspaceId])
}

/// WhatsApp Flow (navigate-only, MVP): authored as raw Meta Flow JSON.
/// Gated behind Workspace.whatsappFlowsEnabled — see whatsappFlowIntegration.ts.
model WhatsAppFlow {
  id          String    @id @default(cuid())
  name        String
  status      String    @default("draft") // draft | published
  flowJson    Json
  categories  String[]  @default([])
  /// Set once published to Meta — not used yet (publish is a later phase).
  metaFlowId  String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Campaign {
  id              String    @id @default(cuid())
  name            String
  status          String    @default("draft")
  templateId      String?
  audienceType    String    @default("all")
  audienceFilter  Json?
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  deliveredCount  Int       @default(0)
  readCount       Int       @default(0)
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime  @default(now())
  /// Touched periodically while sending (see CAMPAIGN_PROGRESS_CHECK_INTERVAL) —
  /// the reaper uses staleness here to tell a genuinely stuck 'running' campaign
  /// (crashed worker) apart from one still actively sending.
  updatedAt       DateTime  @updatedAt
  /// Set when status flips to 'failed' from a pre-send validation error
  /// (e.g. template no longer approved) — the scheduled/worker path had no
  /// column to record why a campaign failed before this, unlike the
  /// synchronous send path which returns the error over HTTP directly.
  lastError       String?

  @@index([workspaceId])
  @@index([status, updatedAt])
}

model Journey {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("draft") // draft | published
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes      JourneyNode[]
  edges      JourneyEdge[]
  executions JourneyExecution[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model JourneyNode {
  id        String  @id @default(cuid())
  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  type      String
  data      Json    @default("{}")
  positionX Float   @default(0)
  positionY Float   @default(0)

  outgoingEdges JourneyEdge[]       @relation("JourneyEdgeSource")
  incomingEdges JourneyEdge[]       @relation("JourneyEdgeTarget")
  executionLogs JourneyExecutionLog[]

  @@index([journeyId])
}

model JourneyEdge {
  id             String      @id @default(cuid())
  journeyId      String
  journey        Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sourceNodeId   String
  sourceNode     JourneyNode @relation("JourneyEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId   String
  targetNode     JourneyNode @relation("JourneyEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  conditionValue String?

  @@index([journeyId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model JourneyExecution {
  id             String    @id @default(cuid())
  journeyId      String
  journey        Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  currentNodeId  String?
  status         String    @default("running") // running | waiting | completed | failed | cancelled
  context        Json?
  /// Optimistic lock — bumped on every updateProgress; a stale-based update is rejected.
  version        Int       @default(0)
  startedAt      DateTime  @default(now())
  lastExecutedAt DateTime?

  logs JourneyExecutionLog[]

  @@index([journeyId])
  @@index([contactId])
  @@index([status])
  @@index([journeyId, contactId])
  // Partial unique index (journeyId, contactId) WHERE status IN ('running','waiting')
  // is added by hand in the migration SQL — Prisma's schema DSL can't express a
  // filtered/partial unique index, so it isn't declared here.
}

model JourneyExecutionLog {
  id          String            @id @default(cuid())
  executionId String
  execution   JourneyExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String?
  node        JourneyNode?      @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  status      String
  payload     Json?
  createdAt   DateTime          @default(now())

  @@index([executionId])
  @@index([nodeId])
}

/// Instagram-only automation (separate from WhatsApp Journey).
