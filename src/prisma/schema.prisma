generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// SaaS tier for workspace (tenant) billing and feature gating.
enum Plan {
  FREE
  STARTER
  GROWTH
  SUPER_ADMIN
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  /// Platform-owner workspace — bypasses plan limits and embedded channel signup.
  isSuperAdmin Boolean @default(false)
  planTier    Plan     @default(FREE)
  legalName   String?
  industry    String?
  website     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?  @default("IN")
  postalCode  String?
  timezone    String?  @default("Asia/Kolkata")
  taxId       String?
  logoUrl     String?
  accountType     String?
  companySize     String?
  planId          String?
  plan            SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionStatus String         @default("trial")
  trialStartedAt  DateTime?
  trialEndsAt     DateTime?
  customPlanSelection Json?
  useCases        String[] @default([])
  heardAbout      String?
  referralCode    String?
  /// Razorpay customer for subscriptions and wallet auto-recharge.
  razorpayCustomerId String?
  waNumberId    String?
  waToken       String?
  wabaId        String?
  waPhoneNumber String?
  fbPageId      String?
  fbPageToken   String?
  fbPageName    String?
  metaAdAccountId String?
  metaUserToken   String?
  /// When true, workspace may send email via shared or custom domains.
  emailIntegrationEnabled Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  whatsappPhoneAccounts WhatsAppPhoneAccount[]
  instagramAccounts     InstagramAccount[]
  messengerAccounts     MessengerAccount[]
  memberships   WorkspaceMembership[]
  users         User[]
  contacts      Contact[]
  conversations     Conversation[]
  campaigns         Campaign[]
  journeys          Journey[]
  agents            AiAgent[]
  agentFlowSessions AgentFlowSession[]
  mediaAssets       MediaAsset[]
  templates         Template[]
  aiKnowledgeConfigs AiKnowledgeConfig[]
  aiKnowledgeRecords AiKnowledge[]
  developerIncomingWebhook DeveloperIncomingWebhook?
  developerOutgoingWebhooks DeveloperOutgoingWebhook[]
  developerActions DeveloperAction[]
  developerSyncEvents DeveloperSyncEvent[]
  developerWebhookLogs DeveloperWebhookLog[]
  emailDomains EmailDomain[]
  emailAddresses EmailAddress[]
  emailLogs EmailLog[]
  emailProviderConfigs EmailProviderConfig[]
  emailTemplates EmailTemplate[]
  cannedResponses CannedResponse[]
  googleConnections GoogleConnection[]
  googleProductIntegrations GoogleProductIntegration[]
  googleSyncLogs GoogleSyncLog[]
  googleWebhookLogs GoogleWebhookLog[]
  googleBusinessAccounts GoogleBusinessAccount[]
  googleBusinessLocations GoogleBusinessLocation[]
  googleBusinessReviews GoogleBusinessReview[]
  googleBusinessMetrics GoogleBusinessMetric[]
  googleBusinessSyncLogs GoogleBusinessSyncLog[]
  trialExtensionLogs   TrialExtensionLog[]
  billingSubscriptions BillingSubscription[]
  billingInvoices      BillingInvoice[]
  billingAddOnPurchases BillingAddOnPurchase[]
  usageLimits          WorkspaceUsageLimits?
  agentChatConversations AgentChatConversation[]
  tokenUsageLogs         TokenUsageLog[]
  cachedResponses        CachedResponse[]
  aiProviderConfig       WorkspaceAiProviderConfig?
  whatsappPaymentRequests WhatsAppPaymentRequest[]
  wallet                  WorkspaceWallet?
  walletTransactions      WalletTransaction[]
  callSessions            CallSession[]
  contactInsights         ContactInsight[]
}

enum GoogleConnectionStatus {
  active
  revoked
  error
  expired
}

enum GoogleProductKey {
  calendar
  business_profile
  sheets
  drive
  gmail
  meet
}

enum GoogleProductStatus {
  disconnected
  connected
  error
}

/// Organization-level Google account (workspace = org tenancy).
model GoogleConnection {
  id              String                 @id @default(cuid())
  workspaceId     String
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  googleAccountId String
  encryptedTokens String
  expiresAt       DateTime?
  scopes          String[]
  status          GoogleConnectionStatus @default(active)
  displayName     String?
  pictureUrl      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  productIntegrations GoogleProductIntegration[]
  syncLogs            GoogleSyncLog[]
  webhookLogs         GoogleWebhookLog[]

  @@unique([workspaceId, googleAccountId])
  @@index([workspaceId])
}

model GoogleProductIntegration {
  id           String              @id @default(cuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection   GoogleConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product      GoogleProductKey
  status       GoogleProductStatus @default(disconnected)
  config       Json?
  lastSyncAt   DateTime?
  lastError    String?
  syncCount    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([connectionId, product])
  @@index([workspaceId])
  @@index([workspaceId, product])
}

model GoogleSyncLog {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  product      GoogleProductKey
  action       String
  status       String
  message      String?
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@index([workspaceId, product])
  @@index([connectionId])
}

model GoogleWebhookLog {
  id           String            @id @default(cuid())
  workspaceId  String
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   GoogleConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  product      GoogleProductKey
  eventType    String
  payload      Json?
  status       String
  error        String?
  processedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@index([workspaceId, product])
}

enum GoogleBusinessSyncStatus {
  idle
  pending
  syncing
  success
  error
}

enum GoogleBusinessSyncType {
  accounts
  locations
  reviews
  metrics
  cache_rebuild
}

/// Cached Google Business Profile account (from mybusinessaccountmanagement).
model GoogleBusinessAccount {
  id                String                   @id @default(cuid())
  workspaceId       String
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId      String
  googleAccountName String
  displayName       String?
  accountType       String?
  rawData           Json?
  lastSyncedAt      DateTime?
  lastSuccessAt     DateTime?
  lastError         String?
  syncStatus        GoogleBusinessSyncStatus @default(idle)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  locations GoogleBusinessLocation[]

  @@unique([connectionId, googleAccountName])
  @@index([workspaceId])
  @@index([connectionId])
}

/// Cached GBP location (from mybusinessbusinessinformation).
model GoogleBusinessLocation {
  id                 String                   @id @default(cuid())
  workspaceId        String
  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId       String
  accountId          String
  account            GoogleBusinessAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  googleLocationName String
  title              String?
  address            Json?
  regularHours       Json?
  metadata           Json?
  rawData            Json?
  lastSyncedAt       DateTime?
  lastLocationSyncAt DateTime?
  lastReviewSyncAt   DateTime?
  lastMetricSyncAt   DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  syncStatus         GoogleBusinessSyncStatus @default(idle)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  reviews GoogleBusinessReview[]
  metrics GoogleBusinessMetric[]

  @@unique([connectionId, googleLocationName])
  @@index([workspaceId])
  @@index([connectionId])
  @@index([accountId])
}

/// Cached GBP review (incremental sync ready).
model GoogleBusinessReview {
  id             String                 @id @default(cuid())
  workspaceId    String
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId   String
  locationId     String
  location       GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  googleReviewId String
  reviewerName   String?
  starRating     Int?
  comment        String?
  reviewReply    String?
  createTime     DateTime?
  updateTime     DateTime?
  rawData        Json?
  lastSyncedAt   DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([locationId, googleReviewId])
  @@index([workspaceId])
  @@index([locationId])
  @@index([updateTime])
}

/// Cached GBP metrics snapshot per location.
model GoogleBusinessMetric {
  id           String                 @id @default(cuid())
  workspaceId  String
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  locationId   String
  location     GoogleBusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  metricType   String
  periodStart  DateTime?
  periodEnd    DateTime?
  value        Json?
  rawData      Json?
  lastSyncedAt DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([workspaceId])
  @@index([locationId])
  @@index([metricType])
}

/// GBP-specific sync audit log (quota, duration, request counts).
model GoogleBusinessSyncLog {
  id            String                 @id @default(cuid())
  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId  String
  syncType      GoogleBusinessSyncType
  durationMs    Int?
  requestCount  Int                    @default(0)
  responseCount Int                    @default(0)
  status        String
  error         String?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([workspaceId, connectionId])
  @@index([syncType])
  @@index([createdAt])
}

model WhatsAppPhoneAccount {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumberId  String
  metaUserId     String?
  wabaId         String
  phoneNumber    String?
  displayName    String?
  /// business_api | app_coexistence
  connectionMode String    @default("business_api")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, phoneNumberId])
  @@index([workspaceId])
  @@index([metaUserId])
}

model InstagramAccount {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramUserId  String
  metaUserId       String?
  pageId           String
  pageName         String?
  username         String?
  displayName      String?
  profilePicture   String?
  pageAccessToken  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceId, instagramUserId])
  @@index([workspaceId])
  @@index([metaUserId])
}

model MessengerAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metaUserId      String?
  pageId          String
  pageName        String?
  displayName     String?
  profilePicture  String?
  pageAccessToken String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, pageId])
  @@index([workspaceId])
  @@index([metaUserId])
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("admin")
  /// Granular access for agents; admins implicitly have all permissions.
  permissions String[]  @default([])
  /// When inbox permission is restricted: channel types and specific account IDs.
  inboxScope  Json?
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([userId])
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("agent")
  avatar      String?
  phone       String?
  jobTitle    String?
  onboardingStep          Int      @default(7)
  onboardingCompleted     Boolean  @default(true)
  onboardingSkippedSteps  Int[]    @default([])
  onboardingData          Json?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime  @default(now())

  memberships           WorkspaceMembership[]
  assignedConversations Conversation[]
  securityState         UserSecurityState?
  assignedCalls         CallSession[]          @relation("CallAssignedAgent")
  acceptedCalls         CallSession[]          @relation("CallAcceptedAgent")
  initiatedCalls        CallSession[]          @relation("CallInitiatedBy")
  callParticipations    CallParticipant[]

  @@index([workspaceId])

}

/// Session invalidation state (logout-everywhere / password change). Separate from User.
model UserSecurityState {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenVersion  Int      @default(0)
  updatedAt     DateTime @updatedAt
  updatedReason String?

  @@map("user_security_states")
}

model Contact {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String?
  avatar        String?
  source        String?
  tags          String[]
  customFields  Json?
  journeyStatus String?
  /// Team/test numbers — never enqueue contact-insight compute
  excludeFromInsights Boolean @default(false)
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations     Conversation[]
  journeyExecutions JourneyExecution[]
  agentFlowSessions AgentFlowSession[]
  whatsappPaymentRequests WhatsAppPaymentRequest[]
  callSessions      CallSession[]
  callParticipations CallParticipant[]
  insights          ContactInsight[]

  @@unique([phone, workspaceId])
  @@index([workspaceId, excludeFromInsights])
}

model Conversation {
  id            String    @id @default(cuid())
  status        String    @default("open")
  channel       String    @default("whatsapp")
  channelAccountId String?
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id])
  assignedTo    String?
  agent         User?     @relation(fields: [assignedTo], references: [id])
  /// Who handles this thread: user | ai | rule_based | journey (null = unassigned automation)
  assigneeType  String?
  /// User id, rule_based agent id, or journey id depending on assigneeType
  assigneeId    String?
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)
  labels        String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages          Message[]
  events            ConversationEvent[]
  agentFlowSession  AgentFlowSession?
  callSessions      CallSession[]

  @@index([workspaceId, contactId])
  @@index([workspaceId, channelAccountId])
}

/// Timeline events for AI ↔ human handover (inbox chat).
model ConversationEvent {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// AI_ASSIGNED | AI_HANDLING_STARTED | HUMAN_TAKEOVER | HUMAN_RELEASED_TO_AI | CONVERSATION_RESOLVED | CONVERSATION_REOPENED
  type           String
  /// AI_AGENT | HUMAN | SYSTEM
  actorType      String
  actorId        String?
  actorName      String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

/// LiveKit 1:1 voice call between customer and agent (media via LiveKit; sockets = signaling only).
model CallSession {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contactId       String?
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// inbound = customer→agent | outbound = agent→customer
  direction       String
  /// initiated | ringing | accepted | connected | declined | missed | ended | failed
  status          String
  roomName        String   @unique
  livekitRoomSid  String?

  /// Who is speaking on the call: none | ai | human
  currentHandler       String    @default("none")
  takenOverAt          DateTime?
  takenOverByUserId    String?

  initiatedByUserId String?
  initiatedBy       User?   @relation("CallInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  assignedTo        String?
  assignedAgent     User?   @relation("CallAssignedAgent", fields: [assignedTo], references: [id], onDelete: SetNull)
  acceptedByUserId  String?
  acceptedBy        User?   @relation("CallAcceptedAgent", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  ringingAt       DateTime?
  ringingUntil    DateTime?
  acceptedAt      DateTime?
  connectedAt     DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  endReason       String?
  /// Audit: [{ at, from, to, reason? }]
  metadata        Json?

  /// Guest (customer) join — short-lived signed link; jti binds one active guest session
  guestTokenJti       String?
  guestTokenExpiresAt DateTime?
  /// Short public code → /c/{code} redirects to /call/{id}?t=…
  guestShortCode      String?  @unique
  guestJoinedAt       DateTime?
  guestLinkSentAt     DateTime?

  /// LiveKit room composite egress (audio) — uploaded after call ends
  /// idle | recording | processing | ready | failed | skipped
  recordingStatus            String?
  recordingEgressId          String?
  recordingStorageKey        String?
  recordingUrl               String?
  recordingStartedAt         DateTime?
  recordingEndedAt           DateTime?
  recordingDurationSeconds   Int?
  recordingCodec             String?
  recordingFileSize          Int?
  recordingError             String?

  /// Client QoS snapshot (packet loss, jitter, rtt, mos, device, browser, …)
  analyticsJson       Json?

  /// Faster-Whisper STT (post-call) — pending | processing | ready | failed | skipped
  transcriptStatus    String?
  transcriptText      String?  @db.Text
  /// [{ start, end, text }]
  transcriptJson      Json?
  transcriptLanguage  String?
  transcriptError     String?
  transcriptAt        DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants    CallParticipant[]

  @@index([workspaceId, status])
  @@index([conversationId])
  @@index([workspaceId, assignedTo, status])
  @@index([workspaceId, createdAt])
  @@index([guestTokenJti])
  @@map("call_sessions")
}

/// History of customer insights (one row per computation — keep trends).
model ContactInsight {
  id                     String   @id @default(cuid())
  workspaceId            String
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId              String
  contact                Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// false = internal/test-only history; scores left null
  isGenuineCustomerInteraction Boolean @default(true)

  /// 0–100 overall relationship health (null if not genuine)
  healthScore            Int?
  /// 0–100; higher = more likely to churn
  churnRiskScore         Int?
  /// 0–100; higher = more ready to buy
  purchaseIntentScore    Int?
  /// −100…100 (negative = negative sentiment)
  sentimentScore         Int?

  summary                String   @db.Text
  /// string[]
  painPoints             Json
  /// string[]
  interests              Json
  recommendedAction      String?  @db.Text

  /// Conversation ids that fed this run
  basedOnConversationIds Json
  /// CallSession ids that fed this run
  basedOnCallSessionIds  Json

  /// Prompt / pipeline version for A/B and regressions
  modelVersion           String
  computedAt             DateTime @default(now())

  @@index([workspaceId, contactId, computedAt])
  @@index([workspaceId, churnRiskScore])
  @@index([workspaceId, purchaseIntentScore])
  @@index([workspaceId, isGenuineCustomerInteraction])
  @@map("contact_insights")
}

model CallParticipant {
  id            String   @id @default(cuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  /// customer | agent | ai | sip
  role          String
  /// LiveKit participant identity
  identity      String
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  joinedAt      DateTime?
  leftAt        DateTime?
  createdAt     DateTime @default(now())

  @@unique([callSessionId, identity])
  @@index([callSessionId])
  @@map("call_participants")
}

model Message {
  id             String       @id @default(cuid())
  waMessageId    String?      @unique
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         String
  senderName     String?
  content        String
  type           String       @default("text")
  status         String       @default("sent")
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])

}

model Template {
  id               String    @id @default(cuid())
  name             String
  category         String
  status           String    @default("draft")
  language         String    @default("en")
  bodyPattern      String
  header           String?
  headerFormat     String?
  headerMediaHandle String?
  headerMediaStorageKey String?
  headerMediaMimeType String?
  headerMediaFileName String?
  footer           String?
  variables        String[]
  buttons          String[]
  buttonType       String?
  buttonText       String?
  buttonUrl        String?
  buttonPhoneNumber String?
  rejectionReason  String?
  waTemplateId     String?
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Campaign {
  id              String    @id @default(cuid())
  name            String
  status          String    @default("draft")
  templateId      String?
  audienceType    String    @default("all")
  audienceFilter  Json?
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  deliveredCount  Int       @default(0)
  readCount       Int       @default(0)
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([workspaceId])

}

model Journey {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("draft") // draft | published
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes      JourneyNode[]
  edges      JourneyEdge[]
  executions JourneyExecution[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model JourneyNode {
  id        String  @id @default(cuid())
  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  type      String
  data      Json    @default("{}")
  positionX Float   @default(0)
  positionY Float   @default(0)

  outgoingEdges JourneyEdge[]       @relation("JourneyEdgeSource")
  incomingEdges JourneyEdge[]       @relation("JourneyEdgeTarget")
  executionLogs JourneyExecutionLog[]

  @@index([journeyId])
}

model JourneyEdge {
  id             String      @id @default(cuid())
  journeyId      String
  journey        Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sourceNodeId   String
  sourceNode     JourneyNode @relation("JourneyEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId   String
  targetNode     JourneyNode @relation("JourneyEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  conditionValue String?

  @@index([journeyId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model JourneyExecution {
  id             String    @id @default(cuid())
  journeyId      String
  journey        Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  currentNodeId  String?
  status         String    @default("running") // running | waiting | completed | failed | cancelled
  context        Json?
  startedAt      DateTime  @default(now())
  lastExecutedAt DateTime?

  logs JourneyExecutionLog[]

