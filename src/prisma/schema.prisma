  startedAt      DateTime  @default(now())
  lastExecutedAt DateTime?

  logs InstagramJourneyExecutionLog[]

  @@index([journeyId])
  @@index([contactId])
  @@index([status])
  @@index([journeyId, contactId])
  // Partial unique index (journeyId, contactId) WHERE status IN ('running','waiting')
  // is added by hand in the migration SQL — Prisma's schema DSL can't express a
  // filtered/partial unique index, so it isn't declared here.
  @@map("instagram_journey_executions")
}

model InstagramJourneyExecutionLog {
  id          String            @id @default(cuid())
  executionId String
  execution   InstagramJourneyExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String?
  node        InstagramJourneyNode?      @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  status      String
  payload     Json?
  createdAt   DateTime          @default(now())

  @@index([executionId])
  @@index([nodeId])
  @@map("instagram_journey_execution_logs")
}

model AiAgent {
  id                        String    @id @default(cuid())
  name                      String
  role                      String
  category                  String    @default("ai_agent")
  description               String?
  avatarUrl                 String?
  welcomeMessageEnabled     Boolean   @default(false)
  welcomeMessageText        String?
  intentFallback            String    @default("silent")
  conversationCloseWaitMins Int       @default(10)
  systemPrompt              String?
  instructions              String?   @db.Text
  toneOfVoice               String    @default("professional")
  fallbackLanguage          String    @default("english")
  brandBackground           String?   @db.Text
  actions                   Json      @default("[]")
  isPublished               Boolean   @default(false)
  publishedAt               DateTime?
  knowledgeBase             Json?
  captureFields             String[]
  escalationRules           Json?
  isEnabled                 Boolean   @default(false)
  /// When true and a conversation is assigned to this agent, call links spawn Pipecat voice agent
  voiceAgentEnabled         Boolean   @default(false)
  /// Pipecat STT provider key (e.g. cartesia, deepgram) — UI dropdown options grow over time
  voiceSttProvider          String    @default("cartesia")
  /// Pipecat TTS provider key (e.g. cartesia)
  voiceTtsProvider          String    @default("cartesia")
  /// Optional provider-specific voice id for TTS
  voiceTtsVoiceId           String?
  conversationsCount        Int       @default(0)
  escalatedCount            Int       @default(0)
  flowsCount                Int       @default(1)
  flowDefinition            Json?
  workspaceId               String
  workspace                 Workspace @relation(fields: [workspaceId], references: [id])
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  flowSessions           AgentFlowSession[]
  skills                 AiSkill[]
  knowledgeItems         AiAgentKnowledgeItem[]
  agentChatConversations AgentChatConversation[]

  @@index([workspaceId])

}

/// Workspace media gallery — shared assets for AI agent, catalog, etc.
model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String
  url         String
  storageKey  String?
  mimeType    String?
  filename    String
  title       String
  description String    @db.Text
  tags        String[]  @default([])
  scope       String    @default("customer")
  /// Consumers that may use this asset, e.g. ["agent"], ["agent","catalog"]
  usage       String[]  @default(["agent"])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, isActive])
  @@index([workspaceId])
}

/// AI agent preview / automated chat sessions (separate from inbox Conversation).
model AgentChatConversation {
  id               String    @id @default(cuid())
  workspaceId      String
  agentId          String
  contactId        String?
  channel          String    @default("preview")
  stage            String    @default("greeting")
  detectedIntent   String?
  totalTokensUsed  Int       @default(0)
  totalCostInr     Float     @default(0)
  messageCount     Int       @default(0)
  lastMessageAt    DateTime  @default(now())
  idleWarning1Sent Boolean   @default(false)
  idleWarning2Sent Boolean   @default(false)
  isActive         Boolean   @default(true)
  closedAt         DateTime?
  closedReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         AgentChatMessage[]
  tokenLogs        TokenUsageLog[]
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent            AiAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, agentId])
  @@index([isActive, lastMessageAt])
}

model AgentChatMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AgentChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String                @db.Text
  tokensUsed     Int                   @default(0)
  intent         String?
  fromCache      Boolean               @default(false)
  createdAt      DateTime              @default(now())

  @@index([conversationId])
}

model TokenUsageLog {
  id             String                 @id @default(cuid())
  workspaceId    String
  agentId        String
  conversationId String?
  conversation   AgentChatConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  costUsd        Float
  costInr        Float
  model          String                 @default("gpt-4o-mini")
  fromCache      Boolean                @default(false)
  intentDetected String?
  skillsLoaded   String[]
  kbChunksLoaded Int                    @default(0)
  createdAt      DateTime               @default(now())
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
}

/// Workspace-level AI provider (ConvoSync hosted vs BYOK).
model WorkspaceAiProviderConfig {
  workspaceId          String    @id
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mode                 String    @default("convosync")
  provider             String    @default("openai")
  model                String    @default("gpt-4o-mini")
  encryptedCredentials String?
  baseUrl              String?
  status               String    @default("active")
  lastTestedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("workspace_ai_provider_configs")
}

/// Bring-your-own email (AWS SES) for workspace transactional/alert sends.
/// Secrets use the same encryptSecret pattern as workspace.waToken.
model WorkspaceEmailConfig {
  workspaceId           String    @id
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// 'ses' | 'platform'
  provider              String    @default("platform")
  accessKeyIdEncrypted  String?
  secretAccessKeyEncrypted String?
  region                String?
  senderEmail           String?
  /// Cached SES verified identities: [{ identity, type: 'email'|'domain' }]
  verifiedIdentities    Json?
  identitiesFetchedAt   DateTime?
  isActive              Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("workspace_email_configs")
}

model AiSkill {
  id               String   @id @default(cuid())
  agentId          String
  agent            AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title            String
  trigger          String   @db.Text
  instructions     String   @db.Text
  description      String?  @db.Text
  knowledgeItemIds String[] @default([])
  status           String   @default("draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agentId])
}

model AiAgentKnowledgeItem {
  id        String   @id @default(cuid())
  agentId   String
  agent     AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String
  title     String
  content   String?  @db.Text
  url       String?
  fileUrl   String?
  metadata  Json?
  status    String   @default("processing")
  createdAt DateTime @default(now())

  @@index([agentId])
}

/// Semantic chunks for AI agent KB (pgvector). Embedding written via raw SQL.
model KnowledgeChunk {
  id              String                       @id @default(cuid())
  workspaceId     String
  agentId         String
  knowledgeItemId String
  chunkIndex      Int
  title           String
  content         String                       @db.Text
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([knowledgeItemId, chunkIndex])
  @@index([workspaceId, agentId])
  @@index([knowledgeItemId])
  @@map("knowledge_chunks")
}

model AgentFlowSession {
  id               String       @id @default(cuid())
  agentId          String
  agent            AiAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversationId   String       @unique
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspaceId      String
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentNodeIndex Int          @default(0)
  waitingForReply  Boolean      @default(false)
  status           String       @default("active")
  context          Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([workspaceId])
  @@index([agentId])
  @@index([contactId])
}

/// Saved connection settings per workspace (for Settings → AI Knowledge UI).
model AiKnowledgeConfig {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  venueId          String?
  connectionString String?
  updatedAt        DateTime  @updatedAt
}

/// Normalized salon knowledge snapshot (ready for future embedding pipeline).
model AiKnowledge {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  venueId      String
  data         Json
  debug        Json?
  status       String    @default("pending") // pending | syncing | success | failed
  errorMessage String?
  syncProgress Json?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, venueId])
  @@index([workspaceId])
  @@map("ai_knowledge")
}

/// Per-workspace incoming webhook endpoint (Developers → Webhooks).
model DeveloperIncomingWebhook {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug             String    @unique
  secret           String
  enabled          Boolean   @default(true)
  subscribedEvents String[]  @default([])
  lastEventAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  @@map("developer_incoming_webhooks")
}

/// Outgoing webhook subscriptions (Developers → Webhooks).
model DeveloperOutgoingWebhook {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  url              String
  secret           String?
  enabled          Boolean   @default(true)
  subscribedEvents String[]  @default([])
  maxRetries       Int       @default(3)
  timeoutMs        Int       @default(10000)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deliveryLogs DeveloperWebhookLog[]

  @@index([workspaceId])
  @@map("developer_outgoing_webhooks")
}

/// Delivery / ingestion logs for developer webhooks.
model DeveloperWebhookLog {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  direction           String    // incoming | outgoing
  outgoingWebhookId   String?
  outgoingWebhook     DeveloperOutgoingWebhook? @relation(fields: [outgoingWebhookId], references: [id], onDelete: SetNull)
  eventType           String
  payload             Json?
  status              String    // success | failed | pending | retrying
  statusCode          Int?
  responseBody        String?
  attempt             Int       @default(1)
  errorMessage        String?
  nextRetryAt         DateTime?
  createdAt           DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([outgoingWebhookId])
  @@map("developer_webhook_logs")
}

/// Configurable HTTP actions for AI Agents + Journey Engine.
model DeveloperAction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actionType  String
  name        String
  method      String    @default("POST")
  url         String    @default("")
  headers     Json      @default("{}")
  timeoutMs   Int       @default(30000)
  enabled     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, actionType])
  @@index([workspaceId])
  @@map("developer_actions")
}

/// Event queue for AI sync and future agent/journey automation.
model DeveloperSyncEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventType    String
  payload      Json?
  status       String    @default("pending") // pending | processing | completed | failed
  errorMessage String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("developer_sync_events")
}

/// Custom sending domains (Developers → Email → Domains).
model EmailDomain {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain           String
  provider         String    @default("resend")
  status           String    @default("pending") // pending | verified | failed
  providerDomainId String?
  spfVerified      Boolean   @default(false)
  dkimVerified     Boolean   @default(false)
  dmarcVerified    Boolean   @default(false)
  dnsRecords       Json?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  addresses EmailAddress[]

  @@unique([workspaceId, domain])
  @@index([workspaceId])
  @@map("email_domains")
}

/// Verified or shared sender identities (Developers → Email → Senders).
model EmailAddress {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domainId    String?
  domain      EmailDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  email       String
  displayName String?
  isDefault   Boolean      @default(false)
  isShared    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("email_addresses")
}

/// Outbound email delivery log (Developers → Email → Logs).
model EmailLog {
  id               String               @id @default(cuid())
  workspaceId      String
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender           String
  recipient        String
  subject          String
  provider         String
  providerConfigId String?
  providerConfig   EmailProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  providerName     String?
  /// queued | sent | delivered | opened | clicked | bounced | complained | rejected | failed | resend_pending | resent
  status           String               @default("queued")
  messageId        String?
  errorMessage     String?
  /// Incremented each time a failed log enters resend_pending
  retryCount       Int                  @default(0)
  /// Includes events[] timeline from Resend/SES webhooks.
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([workspaceId, createdAt])
  @@index([providerConfigId])
  @@index([messageId])
  @@map("email_logs")
}

/// BYOP email provider credentials per workspace (encrypted at rest).
model EmailProviderConfig {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider        String // CONVOSYNC_MANAGED | RESEND | AWS_SES | SENDGRID | SMTP
  isDefault       Boolean   @default(false)
  status          String    @default("active") // active | disabled | credentials_missing | connection_failed
  encryptedConfig String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  logs EmailLog[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([workspaceId, isDefault])
  @@map("email_provider_configs")
}

/// Reusable email templates (subject + HTML) for campaigns, journeys, and transactional sends.
model EmailTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  htmlBody    String    @db.Text
  textBody    String?   @db.Text
  variables   String[]
  status      String    @default("draft") // draft | active
  designJson  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("email_templates")
}

/// Central tag registry for a workspace (Settings → Automation → Tags). Contact.tags stores
/// the actual values on each contact; this table is the curated name+folder list surfaced in
/// tag pickers across the app.
model WorkspaceTag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Freeform grouping label shown as a collapsible section in the Tags settings UI. Null = "Uncategorized".
  folder      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, folder])
  @@map("workspace_tags")
}

model CannedResponse {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  content         String    @db.Text
  shortcut        String?
  mediaStorageKey String?
  mediaMimeType   String?
  mediaFileName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, title])
  @@index([workspaceId])
  @@map("canned_responses")
}

/// SaaS product tiers (Starter, Growth, Pro, Enterprise).
model SubscriptionPlan {
  id              String   @id @default(cuid())
  slug            String   @unique
  planCode        String   @unique
  name            String
  labelColor      String   @default("#6B7280")
  priceMonthly    Int?
  priceAnnual     Int?
  priceMonthlyPaise Int?
  priceAnnualPaise  Int?
  /// Fixed USD catalog prices (no live FX at checkout).
  priceMonthlyUsd   Int?
  priceAnnualUsd    Int?
  priceMonthlyCents Int?
  priceAnnualCents  Int?
  razorpayPlanIdMonthly String?
  razorpayPlanIdAnnual  String?
  /// Razorpay Subscription plan IDs for USD catalog (international checkout).
  razorpayPlanIdMonthlyUsd String?
  razorpayPlanIdAnnualUsd  String?
  priceLabel      String?
  popular         Boolean  @default(false)
  borderColor     String?
  editButtonStyle String   @default("gray")
  features        Json
  sortOrder       Int      @default(0)
  trialDays       Int      @default(14)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspaces            Workspace[]
  billingSubscriptions  BillingSubscription[]
  billingOffers         BillingOffer[]

  @@map("subscription_plans")
}

/// Super-admin–created Razorpay checkout invite for a workspace (subscription or payment link).
model BillingOffer {
  id                       String   @id @default(cuid())
  workspaceId              String
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingCycle             String   @default("monthly") // monthly | annual
  currency                 String   @default("INR") // INR | USD
  amountMinor              Int
  /// subscription | payment_link
  offerType                String
  /// pending | paid | cancelled
  status                   String   @default("pending")
  razorpayPlanId           String?
  razorpaySubscriptionId   String?
  razorpayPaymentLinkId    String?
  /// Hosted checkout URL (subscription short_url or payment link short_url).
  shortUrl                 String?
  note                     String?
  createdByPlatformAdminId String?
  createdBy                PlatformAdmin? @relation(fields: [createdByPlatformAdminId], references: [id], onDelete: SetNull)
  paidAt                   DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([razorpaySubscriptionId])
  @@index([razorpayPaymentLinkId])
  @@map("billing_offers")
}

/// Razorpay recurring subscription for a workspace.
model BillingSubscription {
  id                    String   @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId                String
  plan                  SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  razorpaySubscriptionId String?  @unique
  razorpayCustomerId    String?
  razorpayPlanId        String?
  status                String   @default("created") // created | authenticated | active | paused | cancelled | completed | expired | halted
  billingCycle          String   @default("monthly") // monthly | annual
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean  @default(false)
  cancelledAt           DateTime?
  pausedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  invoices BillingInvoice[]

  @@index([workspaceId])
  @@index([status])
  @@map("billing_subscriptions")
}

/// Payment invoices (subscription renewals, one-time orders, addons).
model BillingInvoice {
  id                    String   @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  razorpayInvoiceId     String?  @unique
  razorpayOrderId       String?
  razorpayPaymentId     String?
  type                  String   @default("subscription") // subscription | order | addon | custom
  amountPaise           Int
  currency              String   @default("INR")
  status                String   @default("created") // created | paid | failed | refunded
  description           String?
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paymentIntents PaymentIntent[]

  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("billing_invoices")
}

/// Idempotent checkout attempts (Razorpay order create / settle).
model PaymentIntent {
  id                 String   @id @default(cuid())
  idempotencyKey     String   @unique
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amount             Int
  currency           String   @default("INR")
  status             String   @default("pending") // pending | success | failed
  razorpayOrderId    String?
  razorpayPaymentId  String?
  failureReason      String?
  billingInvoiceId   String?
  billingInvoice     BillingInvoice? @relation(fields: [billingInvoiceId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payment_intents")
}

/// Dedupes Razorpay webhook deliveries (retried events share eventId).
model RazorpayWebhookLog {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       String
  processedAt DateTime @default(now())

  @@map("razorpay_webhook_logs")
}

/// One-time addon purchases (extra contacts, AI tokens, etc.).
model BillingAddOnPurchase {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type              String    // contacts | team_members | ai_agents | channels | ai_tokens | campaigns
  quantity          Int       @default(1)
  amountPaise       Int
  currency          String    @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            String    @default("pending") // pending | paid | failed | refunded
  validUntil        DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([razorpayOrderId])
  @@map("billing_addon_purchases")
}

/// Per-workspace usage limits (base plan + addons).
model WorkspaceUsageLimits {
  workspaceId       String   @id
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactsLimit     Int      @default(1000)
  teamMembersLimit  Int      @default(3)
  aiAgentsLimit     Int      @default(1)
  channelsLimit     Int      @default(2)
  aiTokensIncluded  Int      @default(0)
  campaignsLimit    Int      @default(3)
  emailsLimit       Int      @default(1000)
  updatedAt         DateTime @updatedAt

  @@map("workspace_usage_limits")
}

/// Prepaid usage wallet — credits for WhatsApp templates, AI tokens, and other metered features.
model WorkspaceWallet {
  workspaceId              String    @id
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  balancePaise             Int       @default(0)
  lowBalanceThresholdPaise Int       @default(50000)
  lowBalanceAlertAt        DateTime?
  autoRechargeEnabled      Boolean   @default(false)
  autoRechargeAmountPaise  Int       @default(100000)
  razorpayTokenId          String?
  autoRechargeStatus       String    @default("idle")
  lastAutoRechargeAt       DateTime?
  autoRechargeFailCount    Int       @default(0)
  autoRechargeCooldownUntil DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("workspace_wallets")
}

/// Ledger entries for wallet credits (top-up) and debits (feature usage).
model WalletTransaction {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type              String
  category          String
  amountPaise       Int
  balanceAfterPaise Int
  description       String?
  referenceType     String?
  referenceId       String?
  idempotencyKey    String?         @unique
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([workspaceId, createdAt])
  @@index([category])
  @@map("wallet_transactions")
}

/// Landing / marketing demo booking requests (platform inbox).
model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("new")
  source    String   @default("landing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("demo_requests")
}

/// Landing Help & Support form submissions.
model SupportRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new")
  source    String   @default("landing")
  /// Set only for in-app requests (e.g. whatsapp_flow_request) so admins can act on the workspace directly.
  workspaceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@map("support_requests")
}

/// Platform operators (super admin) — separate from tenant User records.
model PlatformAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("super_admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trialExtensionLogs   TrialExtensionLog[]
  platformAuditLogs    PlatformAuditLog[]
  billingOffers        BillingOffer[]
}

/// Super-admin platform audit trail (org/plan/coupon/auth actions).
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  category   String   @default("system")
  severity   String   @default("info")
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  platformAdmin PlatformAdmin? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([category])
  @@index([actorEmail])
  @@map("platform_audit_logs")
}

/// Inbound webhook debug log for Super Admin (WhatsApp / Meta / etc.).
/// workspaceId is best-effort — no FK (unknown or deleted workspaces still keep the row).
model WebhookEventLog {
  id          String   @id @default(cuid())
  source      String // whatsapp | instagram | messenger | meta | …
  eventType   String // messages | statuses | message_template_status_update | …
  object      String? // Meta object: whatsapp_business_account | page | instagram
  workspaceId String?
  summary     String?
  payload     Json?
  error       String?
  receivedAt  DateTime @default(now())

  @@index([receivedAt])
  @@index([source, receivedAt])
  @@index([eventType])
  @@map("webhook_event_logs")
}

/// Record of super-admin trial extensions (days + reason).
model TrialExtensionLog {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platformAdminId String?
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  daysAdded       Int
  reason          String
  previousEndsAt  DateTime?
  newEndsAt       DateTime
  createdAt       DateTime       @default(now())

  @@index([workspaceId, createdAt])
  @@map("trial_extension_logs")
}

/// Singleton platform configuration for super-admin (messaging number, branding).
model PlatformConfig {
  id                    String   @id @default("default")
  platformName          String   @default("ConvoSync")
  supportEmail          String?
  platformPhone         String?
  platformPhoneNumberId String?
  platformWabaId        String?
  platformWaToken       String?
  updatedAt             DateTime @updatedAt

  @@map("platform_config")
}

/// Platform-wide discount coupons (super-admin managed; applied at plan checkout).
model DiscountCoupon {
  id                     String   @id @default(cuid())
  code                   String   @unique
  /// 0–100 inclusive
  discountPercent        Int
  /// Cap on discount in paise (percent applied first, then min with this cap). Null = no cap.
  maxDiscountAmountPaise Int?
  validFrom              DateTime
  validUntil             DateTime
  maxRedemptions         Int
  redemptionCount        Int      @default(0)
  /// Minimum order amount in paise before coupon applies; null = no minimum.
  minOrderAmountPaise    Int?
  /// Self-serve plan slugs this coupon applies to; empty = all plans.
  applicablePlanSlugs    String[] @default([])
  /// Bonus ConvoCoins credited to wallet on redeem; null/0 = none.
  bonusWalletCreditsCc   Int?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  redemptions DiscountCouponRedemption[]

  @@index([isActive])
  @@index([validFrom, validUntil])
  @@map("discount_coupons")
}

/// Ledger row when a coupon is redeemed on successful plan checkout.
model DiscountCouponRedemption {
  id                  String         @id @default(cuid())
  couponId            String
  coupon              DiscountCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  workspaceId         String
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discountAmountPaise Int
  invoiceId           String         @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([couponId])
  @@index([workspaceId])
  @@index([couponId, workspaceId])
  @@map("discount_coupon_redemptions")
}

/// WhatsApp templates used by platform ops to message client organizations.
model PlatformMessageTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("utility")
  language  String   @default("en")
  body      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("platform_message_templates")
}

/// In-chat payment requests sent via WhatsApp (Razorpay payment links).
model WhatsAppPaymentRequest {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId             String?
  contact               Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName           String
  contactPhone          String
  amountPaise           Int
  currency              String    @default("INR")
  description           String
  status                String    @default("draft")
  razorpayPaymentLinkId String?
  paymentLinkUrl        String?
  razorpayPaymentId     String?
  waMessageId           String?
  sendMode              String    @default("plain")
  templateId            String?
  templateVariables     String[]  @default([])
  sentAt                DateTime?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdByName         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([razorpayPaymentLinkId])
  @@map("whatsapp_payment_requests")
}

