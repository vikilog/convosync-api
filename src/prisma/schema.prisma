  positionX Float   @default(0)
  positionY Float   @default(0)

  outgoingEdges InstagramJourneyEdge[]       @relation("IgJourneyEdgeSource")
  incomingEdges InstagramJourneyEdge[]       @relation("IgJourneyEdgeTarget")
  executionLogs InstagramJourneyExecutionLog[]

  @@index([journeyId])
  @@map("instagram_journey_nodes")
}

model InstagramJourneyEdge {
  id             String      @id @default(cuid())
  journeyId      String
  journey        InstagramJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sourceNodeId   String
  sourceNode     InstagramJourneyNode @relation("IgJourneyEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId   String
  targetNode     InstagramJourneyNode @relation("IgJourneyEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  conditionValue String?

  @@index([journeyId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("instagram_journey_edges")
}

model InstagramJourneyExecution {
  id             String    @id @default(cuid())
  journeyId      String
  journey        InstagramJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  currentNodeId  String?
  status         String    @default("running") // running | waiting | completed | failed | cancelled
  context        Json?
  /// Optimistic lock — bumped on every updateProgress; a stale-based update is rejected.
