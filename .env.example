DATABASE_URL="postgresql://convosync:convosync_secret@localhost:5432/convosync"
DIRECT_URL="postgresql://convosync:convosync_secret@localhost:5432/convosync"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
PORT=4000

# Public API base URL (dev tunnel / production) — no trailing slash
BACKEND_PUBLIC_URL="http://localhost:4000"

# Public URL where you open the ConvoSync UI (no trailing slash)
FRONTEND_URL="http://localhost:3000"
# Browser origins for CORS (comma-separated). Must match where you OPEN the UI, not the API URL.
# Example: http://localhost:3000,https://your-frontend.ngrok-free.app
CORS_ALLOWED_ORIGINS=""
# Set to false to disable auto-allow for localhost / ngrok / devtunnels in development
# CORS_DEV_RELAXED=true

# Meta
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
# Embedded Signup v4 — coexistence (WhatsApp Business App onboarding product in Meta config)
META_WHATSAPP_CONFIG=""
META_WEBHOOK_VERIFY_TOKEN="convosync_verify_token"
# Popup Embedded Signup — must match where users open WhatsApp connect (no query string)
# Production example: https://wabiz.classivo.app/integrations
META_EMBEDDED_REDIRECT_URI="http://localhost:3000/integrations"
META_OAUTH_REDIRECT_URI="http://localhost:3000/manager"
# Instagram connect — must match frontend /instagram/callback and Meta Valid OAuth Redirect URIs
META_INSTAGRAM_REDIRECT_URI="http://localhost:3000/instagram/callback"
# Server-side OAuth callback (only if using backend redirect flow)
# Defaults to BACKEND_PUBLIC_URL + /api/whatsapp/oauth/callback if unset
# META_OAUTH_BACKEND_CALLBACK_URI="http://localhost:4000/api/whatsapp/oauth/callback"
# Meta webhook callback: BACKEND_PUBLIC_URL + /api/webhook/whatsapp
# Instagram DMs webhook: BACKEND_PUBLIC_URL + /api/webhook/instagram (Page object, messages field)

# Google Workspace integrations (Calendar, Gmail, Drive, Sheets, Meet, Business Profile)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/google/callback"

GEMINI_API_KEY=""

# OpenAI (AI Agent preview / test chat)
OPENAI_API_KEY=""
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone vector DB (AI agent knowledge base)
# PINECONE_INDEX must be an existing index name in your Pinecone project (not a display alias).
PINECONE_API_KEY=""
PINECONE_INDEX="text-embedding-3-small"
# Copy full host from Pinecone → Indexes → Connect (must match PINECONE_INDEX)
# PINECONE_HOST="https://text-embedding-3-small-xxxxx.svc.apcd-xxxx.pinecone.io"
PINECONE_EMBEDDING_MODEL="llama-text-embed-v2"
# Must match index dimension (llama-text-embed-v2 default is 1024; this project index is 2048)
PINECONE_EMBEDDING_DIMENSION=2048
# PINECONE_EMBEDDING_PROVIDER=pinecone
# PINECONE_TOP_K=5

# AI Agent hybrid retrieval + Redis cache
# CACHE_TTL_SECONDS preferred; falls back to AI_CACHE_TTL_SECONDS (default 24h)
CACHE_TTL_SECONDS=86400
# AI_CACHE_TTL_SECONDS=86400
SIMILARITY_HIGH_THRESHOLD=0.85
SIMILARITY_LOW_THRESHOLD=0.60
HYBRID_TOP_K=3
# AI_ESCALATE_ON_LOW_SCORE=true
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_HISTORY_MESSAGES=6
AI_IDLE_TIMEOUT_MINUTES=15

# Email (Resend platform default / BYOP)
EMAIL_DEFAULT_PROVIDER="resend"
CONVOSYNC_SHARED_EMAIL_DOMAIN="mail.convosync.io"
# Encrypts BYOP provider credentials at rest (32+ chars; falls back to JWT_SECRET in dev)
EMAIL_CONFIG_ENCRYPTION_KEY=""
# Platform Resend key (also used when workspace provider has no BYOP key)
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Resend webhook URL (public): BACKEND_PUBLIC_URL + /api/webhook/resend
# Optional: AWS SES for BYOP ConvoSync Managed workspaces
# Platform SES uses AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION below

# Razorpay billing (INR)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Set true to use Razorpay Subscriptions (auto-renew). Also auto-enabled when RAZORPAY_PLAN_* IDs are set.
RAZORPAY_RECURRING_ENABLED="true"
# Test/live plan IDs from Dashboard → Subscriptions → Plans
RAZORPAY_PLAN_STARTER_MONTHLY="plan_T5qg9PRwuD7zNW"
# RAZORPAY_PLAN_STARTER_ANNUAL="plan_xxxxxxxx"
# RAZORPAY_PLAN_GROWTH_MONTHLY="plan_xxxxxxxx"
# RAZORPAY_PLAN_GROWTH_ANNUAL="plan_xxxxxxxx"
# RAZORPAY_PLAN_PRO_MONTHLY="plan_xxxxxxxx"
# RAZORPAY_PLAN_PRO_ANNUAL="plan_xxxxxxxx"
# Sync plans: npm run razorpay:sync-plans  |  List remote: npm run razorpay:list-plans
# Webhook URL (public): BACKEND_PUBLIC_URL + /api/webhooks/razorpay

# File uploads (S3). When set, media is stored in AWS S3 instead of local disk.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME=""
# Optional: force bucket endpoint if region redirect errors persist
# AWS_S3_ENDPOINT="https://convosync.s3.ap-south-1.amazonaws.com"
# Optional prefix inside the bucket (default: uploads)
AWS_S3_PREFIX="uploads"

# Super admin tenant (platform owner workspace — seeded via npm run seed:admin)
# Login credentials for the ConvoSync tenant app (not the platform super-admin dashboard)
SUPER_ADMIN_EMAIL="admin@convosync.io"
SUPER_ADMIN_PASSWORD="Admin@123"
# WhatsApp Graph for isSuperAdmin workspace uses this long-lived token (not Embedded Signup token)
# WhatsApp Business Account ID — Meta Business Suite → WhatsApp Manager → Account settings
SUPER_ADMIN_WABA_ID=""
# Phone number ID — WhatsApp Manager → Phone numbers → select number → Phone number ID
SUPER_ADMIN_PHONE_NUMBER_ID=""
# Permanent system user access token — Meta Business Settings → System users → Generate token (whatsapp_business_management, whatsapp_business_messaging)
SUPER_ADMIN_ACCESS_TOKEN=""
# Instagram Business account ID — Meta Business Suite → Instagram account settings, or Graph API ig-user-id
SUPER_ADMIN_IG_ACCOUNT_ID=""
# Long-lived page access token with instagram_manage_messages — Graph API Explorer or System user token for the linked Page
SUPER_ADMIN_IG_ACCESS_TOKEN=""

# LiveKit voice calling (secrets never sent to clients)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# LIVEKIT_RING_TIMEOUT_SECONDS=45
# LIVEKIT_ACCEPT_JOIN_GRACE_SECONDS=45
# LIVEKIT_TOKEN_TTL_SECONDS=600
# CALL_GUEST_TOKEN_TTL_SECONDS=7200
# Post-call Faster-Whisper STT (standalone Python project: ../stt)
#   cd ../stt && python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt
# Local monorepo: npm run dev starts api + web + stt HTTP on :8091
# CALL_STT_ENABLED=true
# CALL_STT_URL=http://127.0.0.1:8091
# Prod: point CALL_STT_URL at the dedicated STT host (leave empty to spawn CLI instead)
# CALL_STT_PYTHON=../stt/.venv/bin/python3
# CALL_STT_SCRIPT=../stt/transcribe.py
# CALL_STT_MODEL=medium
# auto | hi | en | bn | ta | te | mr | gu | kn | ml | pa | ur …
# CALL_STT_LANGUAGE=auto
# When auto detects English on Hinglish, retry as Hindi:
# CALL_STT_PREFER_LANGUAGE=hi
# CALL_STT_INITIAL_PROMPT=
# CALL_STT_DEVICE=auto   # auto → NVIDIA CUDA if available, else cpu (Apple Metal not supported)
# CALL_STT_COMPUTE_TYPE=default  # auto: float16 on cuda, int8 on cpu

# Pipecat voice AI agent (joins LiveKit when conversation assigned to AI with voiceAgentEnabled)
# VOICE_AGENT_SERVICE_URL=http://127.0.0.1:8092
# VOICE_AGENT_START_TIMEOUT_MS=4000
# Shared secret for /api/internal/* (voice agent → transcript ingest)
# CONVOSYNC_INTERNAL_SECRET=
# Customer Insight pipeline (Phase 1 infra; set LLM=true after Phase 2 prompt)
# CONTACT_INSIGHT_ENABLED=true
# CONTACT_INSIGHT_LLM_ENABLED=true
# CONTACT_INSIGHT_MODEL_VERSION=insight-v2
# CONTACT_INSIGHT_MIN_INTERACTIONS=3
# CONTACT_INSIGHT_LOW_SIGNAL_THRESHOLD=5
# CONTACT_INSIGHT_MIN_GAP_HOURS=6
# CONTACT_INSIGHT_MAX_CONVERSATIONS=10
# CONTACT_INSIGHT_LOOKBACK_DAYS=90
# CONTACT_INSIGHT_MAX_CALLS=10
# CONTACT_INSIGHT_CHURN_TAG_THRESHOLD=70
# CONTACT_INSIGHT_PURCHASE_TAG_THRESHOLD=70
# CONTACT_INSIGHT_CHURN_TAG=high_churn_risk
# CONTACT_INSIGHT_PURCHASE_TAG=hot_lead
# CONTACT_INSIGHT_NIGHTLY_HOUR=2

# OpenTelemetry → local collector (docker-compose.observability.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logging (quiet by default — set LOG_LEVEL=info for request logs)
# LOG_LEVEL=warn
# Performance instrumentation (opt-in only — leave off unless investigating)
# PERF_TIMING=true
# PERF_QUERY_LOG=true
# PERF_QUERY_LOG_VERBOSE=true   # log every query when PERF_QUERY_LOG=true (default: only ≥250ms)
